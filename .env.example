# ====== PostgreSQL ======
POSTGRES_USER=atrium
POSTGRES_PASSWORD=atrium_pass
POSTGRES_DB=atrium
# Опционально: проброс порта БД на хост (пусто = только docker-network).
# Если на хосте 5432 занят, задайте DB_HOST_PORT=54329 и используйте его в TEST_DATABASE_URL.
DB_HOST_PORT=

# ====== MinIO ======
# По умолчанию используется зеркало dappros/minio (работает там, где
# docker.io/minio/minio заблокирован). Если у вас есть доступ к Docker Hub,
# можно поставить MINIO_IMAGE=minio/minio:latest
MINIO_IMAGE=dappros/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_admin_pass
MINIO_API_PORT=9090
MINIO_CONSOLE_PORT=9091
S3_BUCKET=atrium-media
S3_REGION=us-east-1

# ====== Backend / JWT ======
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=60

# ====== Reservations ======
RESERVATION_HOLD_MIN=15
RESERVATION_DEFAULT_DURATION_MIN=120
DEPOSIT_AMOUNT=500

# ====== Payment provider (stub | stripe | yukassa | tinkoff) ======
PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=change_me_webhook_secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
TINKOFF_TERMINAL_KEY=
TINKOFF_PASSWORD=

# ====== Nginx ======
HTTP_PORT=80
HTTPS_PORT=443

# ====== App ======
FRONTEND_BASE_URL=http://localhost

# ====== Seed ======
SEED_ADMIN_EMAIL=admin@atrium.local
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=Администратор
SEED_TEST_CLIENT_EMAIL=client@atrium.local
SEED_TEST_CLIENT_PASSWORD=client12345